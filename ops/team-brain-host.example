#!/bin/sh
# Install as a host-owned executable only after release approval.
# Replace REVIEWED_COMMIT with the exact approved source commit before packaging.
exec /usr/bin/python3 -I -B -c 'import sys; sys.path.insert(0, "/opt/team-brain/releases/REVIEWED_COMMIT"); from team_brain.host import main; main()' --config /var/lib/team-brain/config.json
